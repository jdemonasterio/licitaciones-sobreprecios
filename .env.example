# Copiar a .env (o correr configurar_claves.bat) y completar.
# El .env nunca se comparte ni se sube a git. Solo estas variables: nada más hace falta.

# Clave GRATIS de Google AI Studio (https://aistudio.google.com/apikey). Recomendada.
GEMINI_API_KEY=

# Opcional, respaldo gratis: modelos ':free' de OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Opcional, de pago (más rápido): OpenAI.
OPENAI_API_KEY=

# gratis (default, más lento, sin costo) | pago (usa gpt-6-luna; requiere OPENAI_API_KEY)
LIC_LLM_PERFIL=gratis

# 1 = no usar ningún LLM (solo reglas). Útil para probar sin claves.
# LIC_LLM_OFFLINE=1

# Opcional: dump MySQL del sistema 2021 para el demo (si no está, se usa data/quijotes.sql)
# LIC_QUIJOTE_DUMP=

# --- Solo para un despliegue en la nube con URL pública (ver docs/despliegue_nube.md) ---
# En tu compu (local) dejá estas 4 sin completar: así el webui sigue sin login, como siempre.

# Dónde vive la base y los caches: en la nube apuntan al volumen persistente (ej. /data).
# LIC_DB_PATH=/data/sobreprecios.db
# LIC_CACHE_DIR=/data/cache

# 1 = versión pública de SOLO LECTURA: nadie puede guardar cambios ni correr búsquedas nuevas desde ahí.
# LIC_MODO_PUBLICO=1

# Usuario y clave para pedir contraseña a TODA la página (HTTP Basic). Si completás las dos,
# se activa; si una queda vacía, no pide nada (como en tu compu).
# LIC_USUARIO=
# LIC_CLAVE=

# Nombres/IPs adicionales desde los que se puede abrir la página (se agregan a 127.0.0.1 y
# localhost, que siempre están permitidos). En la nube: el dominio que te dé la plataforma
# y tu dominio propio si comprás uno, separados por coma.
# LIC_HOSTS_PERMITIDOS=tuapp.up.railway.app,tudominio.com
